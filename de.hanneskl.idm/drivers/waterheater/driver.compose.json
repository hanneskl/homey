{
  "name": {
    "en": "Water heater"
  },
  "class": "heater",
  "capabilities": [
    "onoff",
    "measure_power",
    "measure_power_produced",
    "measure_efficiency",
    "target_temperature",
    "measure_temperature",
    "measure_temperature_top",
    "measure_temperature_bottom"
  ],
  "capabilitiesOptions": {
    "onoff": {
      "title": {
        "en": "Heating"
      }
    },
    "measure_temperature": {
      "title": {
        "en": "Temperature"
      },
      "min": 10,
      "max": 80,
      "step": 1,
      "decimals": 0
    },
    "target_temperature": {
      "min": 30,
      "max": 50,
      "step": 1,
      "decimals": 0
    }
  },
  "platforms": [
    "local"
  ],
  "connectivity": [
    "lan"
  ],
  "images": {
    "small": "/drivers/waterheater/assets/images/small.png",
    "large": "/drivers/waterheater/assets/images/large.png",
    "xlarge": "/drivers/waterheater/assets/images/xlarge.png"
  },
  "pair": [
    {
      "id": "list_devices",
      "template": "list_devices",
      "navigation": {
        "next": "add_devices"
      },
      "options": {
        "singular": true
      }
    },
    {
      "id": "add_devices",
      "template": "add_devices"
    }
  ],
  "settings": [
    {
      "id": "host",
      "type": "text",
      "label": {
        "en": "IDM address"
      },
      "value": "192.168.87.84",
      "hint": {
        "en": "IP address or hostname of the IDM heatpump"
      }
    },
    {
      "id": "pin",
      "type": "password",
      "label": {
        "en": "PIN"
      },
      "value": "",
      "hint": {
        "en": "PIN of the IDM web interface. With a PIN the app logs in by itself, also after the IDM restarted. Use the same settings on all IDM devices."
      }
    },
    {
      "id": "cookie",
      "type": "text",
      "label": {
        "en": "Cookie (optional)"
      },
      "description": {
        "en": "Only needed without PIN: get the cookie from the IDM web interface"
      },
      "placeholder": {
        "en": "e.g., MYIDM=3bdc1db6227e097f2b459823667fb668"
      }
    },
    {
      "id": "csfr",
      "type": "text",
      "label": {
        "en": "CSFR-Token (optional)"
      },
      "description": {
        "en": "Only needed without PIN: get the csfr token from the IDM web interface"
      },
      "placeholder": {
        "en": "e.g., 68593c363abca"
      }
    }
  ]
}